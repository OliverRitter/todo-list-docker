# Local development database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=fullstack_db

# Generate a unique random value for Better Auth if you use auth locally
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional pgAdmin login
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-this-local-password
